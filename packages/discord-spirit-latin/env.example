# Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord Application ID
# Get this from https://discord.com/developers/applications
DISCORD_APPLICATION_ID=your_application_id_here

# Discord Public Key
# Get this from https://discord.com/developers/applications
DISCORD_PUBLIC_KEY=your_public_key_here

# Allowed Channels (optional)
# Comma-separated list of channel IDs where the bot should work
# If not set or empty, bot will work in all channels
# Example: ALLOWED_CHANNELS=123456789012345678,987654321098765432
ALLOWED_CHANNELS=
