{
  "name": "@interslavic/discord-spirit-latin",
  "version": "1.0.2",
  "description": "Discord bot that provides Latin script transliteration for Cyrillic and Glagolitic messages",
  "main": "index.js",
  "type": "module",
  "bin": "index.js",
  "files": [
    "index.js"
  ],
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch src/index.ts",
    "build": "yarn run -T tsc --noEmit && node esbuild.config.js",
    "test": "node --test src/**/*.test.ts",
    "clean": "rm -f index.js"
  },
  "keywords": [
    "discord",
    "bot",
    "interslavic",
    "transliteration",
    "cyrillic",
    "glagolitic",
    "latin"
  ],
  "author": "Interslavic OSS <oss@interslavic.fun>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/medzuslovjansky/duhi.git",
    "directory": "packages/discord-spirit-latin"
  },
  "dependencies": {
    "@interslavic/translit": "^0.2.1",
    "@types/unist": "^3.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "retext": "^9.0.0",
    "retext-english": "^5.0.0",
    "retext-stringify": "^4.0.0",
    "retext-syntax-urls": "^4.0.0",
    "unified": "^11.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
