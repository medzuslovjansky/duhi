{
  "name": "@interslavic/discord-spirit-latin",
  "version": "1.0.0",
  "description": "Discord bot that provides Latin script transliteration for Cyrillic and Glagolitic messages",
  "main": "src/index.ts",
  "type": "module",
  "bin": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "build": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts",
    "clean": "echo 'No clean step needed'"
  },
  "keywords": [
    "discord",
    "bot",
    "interslavic",
    "transliteration",
    "cyrillic",
    "glagolitic",
    "latin"
  ],
  "author": "Interslavic OSS <oss@interslavic.fun>",
  "license": "MIT",
  "dependencies": {
    "@interslavic/utils": "^3.4.2",
    "@types/unist": "^3.0.0",
    "discord.js": "^14.14.1",
    "dotenv": "^17.2.3",
    "retext": "^9.0.0",
    "retext-english": "^5.0.0",
    "retext-stringify": "^4.0.0",
    "retext-syntax-urls": "^4.0.0",
    "unified": "^11.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
